<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400" width="1200" height="400">
  <defs>
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#003d82" />
      <stop offset="100%" stop-color="#002654" />
    </linearGradient>
    <linearGradient id="cyanGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00bcd4" />
      <stop offset="100%" stop-color="#008ba3" />
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffc107" />
      <stop offset="100%" stop-color="#ff9800" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="2" dy="4" stdDeviation="4" flood-color="#000000" flood-opacity="0.25" />
    </filter>
  </defs>

  <!-- Shield & Net Mesh Icon -->
  <g transform="translate(60, 40)">
    <!-- Base Shield -->
    <path d="M 160 20 L 280 60 L 280 200 C 280 280 160 330 160 330 C 160 330 40 280 40 200 L 40 60 Z" fill="url(#shieldGrad)" stroke="url(#cyanGrad)" stroke-width="8" filter="url(#shadow)" />
    
    <!-- Inner Net Mesh Pattern -->
    <g stroke="url(#cyanGrad)" stroke-width="4" opacity="0.85">
      <!-- Diagonal Mesh Lines -->
      <line x1="80" y1="90" x2="240" y2="250" />
      <line x1="120" y1="75" x2="260" y2="215" />
      <line x1="160" y1="65" x2="275" y2="180" />
      <line x1="65" y1="135" x2="215" y2="285" />

      <line x1="240" y1="90" x2="80" y2="250" />
      <line x1="200" y1="75" x2="60" y2="215" />
      <line x1="160" y1="65" x2="45" y2="180" />
      <line x1="255" y1="135" x2="105" y2="285" />
    </g>

    <!-- Center Gold Star Safety Seal -->
    <circle cx="160" cy="170" r="35" fill="url(#goldGrad)" />
    <path d="M 160 145 L 168 162 L 186 163 L 172 175 L 177 193 L 160 182 L 143 193 L 148 175 L 134 163 L 152 162 Z" fill="#002654" />
  </g>

  <!-- Typography -->
  <!-- "SRAVANI" -->
  <text x="420" y="200" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="110" fill="#003d82" letter-spacing="4">
    SRAVANI
  </text>

  <!-- "NETTING SOLUTIONS" -->
  <text x="425" y="275" font-family="system-ui, -apple-system, sans-serif" font-weight="800" font-size="46" fill="#ffc107" letter-spacing="8">
    NETTING SOLUTIONS
  </text>

  <!-- Tagline -->
  <text x="427" y="325" font-family="system-ui, -apple-system, sans-serif" font-weight="600" font-size="24" fill="#00bcd4" letter-spacing="3">
    SAFETY NETS • INVISIBLE GRILLS • CHENNAI
  </text>
</svg>